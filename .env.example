# MongoDB Atlas connection string (Database Access user + Network Access IP).
# Example: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/oblyx?retryWrites=true&w=majority
MONGODB_URI=

# Shared secret for the admin dashboard (sent as x-admin-code header).
# Use a long random string, e.g. output of: openssl rand -base64 32
ADMIN_CODE=
