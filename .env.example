# Copy to .env.local and fill in.
# Without this, handle checks run in mock mode (format-only).
X_BEARER_TOKEN=
# Needed later for Login with X (real task verification):
# X_CLIENT_ID=
# X_CLIENT_SECRET=

# MongoDB Atlas connection string (same cluster as the Oblyx allowlist).
# Copied from the sibling project — keep in .env.local, never commit.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/oblyx?retryWrites=true&w=majority
